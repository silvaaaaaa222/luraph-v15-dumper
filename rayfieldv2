        -- Drag
        local dragging, dragInput, dragStart, startPos
        top.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        top.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local d = input.Position - dragStart
                main.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)

        -- TabBar
        local tabBar = Instance.new("Frame", main)
        tabBar.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        tabBar.Position = UDim2.new(0, 0, 0, 40)
        tabBar.Size = UDim2.new(0, 110, 1, -40)
        tabBar.BorderSizePixel = 0
        local tcr2 = Instance.new("UICorner", tabBar); tcr2.CornerRadius = UDim.new(0, 8)
        local tll = Instance.new("UIListLayout", tabBar)
        tll.Padding = UDim.new(0, 6)
        tll.HorizontalAlignment = Enum.HorizontalAlignment.Center

        local pages = Instance.new("Frame", main)
        pages.BackgroundTransparency = 1
        pages.Position = UDim2.new(0, 120, 0, 50)
        pages.Size = UDim2.new(1, -130, 1, -60)

        local winAPI = {}
        local tabCount = 0

        function winAPI:CreateTab(tabName, icon)
            tabCount = tabCount + 1
            local page = Instance.new("ScrollingFrame", pages)
            page.BackgroundTransparency = 1
            page.Size = UDim2.new(1, 0, 1, 0)
            page.BorderSizePixel = 0
            page.ScrollBarThickness = 2
            page.ScrollBarImageColor3 = ACCENT
            page.CanvasSize = UDim2.new(0, 0, 0, 0)
            page.Visible = (tabCount == 1)
            local pll = Instance.new("UIListLayout", page)
            pll.Padding = UDim.new(0, 8)
            pll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                page.CanvasSize = UDim2.new(0, 0, 0, pll.AbsoluteContentSize.Y)
            end)

            local btn = Instance.new("TextButton", tabBar)
            btn.Size = UDim2.new(0, 100, 0, 32)
            btn.BorderSizePixel = 0
            btn.Text = tabName
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 11
            btn.BackgroundColor3 = tabCount == 1 and ACCENT or BG_ELEM
            btn.TextColor3 = tabCount == 1 and Color3.fromRGB(255,255,255) or Color3.fromRGB(150,150,150)
            local bcr = Instance.new("UICorner", btn); bcr.CornerRadius = UDim.new(0, 6)

            btn.MouseButton1Click:Connect(function()
                for _, p in ipairs(pages:GetChildren()) do p.Visible = false end
                for _, b in ipairs(tabBar:GetChildren()) do
                    if b:IsA("TextButton") then
                        b.BackgroundColor3 = BG_ELEM
                        b.TextColor3 = Color3.fromRGB(150, 150, 150)
                    end
                end
                page.Visible = true
                btn.BackgroundColor3 = ACCENT
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            end)

            local tabAPI = {}
            local function safe(cb, ...)
                if not cb then return end
                local ok, err = pcall(cb, ...)
                if not ok then warn("[joaozin] " .. tostring(err)) end
            end

            -- Button
            function tabAPI:CreateButton(c)
                local b = Instance.new("TextButton", page)
                b.Size = UDim2.new(1, 0, 0, 38)
                b.BackgroundColor3 = BG_ELEM
                b.BorderSizePixel = 0
                b.Text = c.Name or "Button"
                b.TextColor3 = Color3.fromRGB(255, 255, 255)
                b.Font = Enum.Font.GothamBold
                b.TextSize = 13
                b.AutoButtonColor = false
                local bcr2 = Instance.new("UICorner", b); bcr2.CornerRadius = UDim.new(0, 6)
                b.MouseEnter:Connect(function()
                    TS:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = BG_HOVER}):Play()
                end)
                b.MouseLeave:Connect(function()
                    TS:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = BG_ELEM}):Play()
                end)
                b.MouseButton1Click:Connect(function() safe(c.Callback) end)
                return b
            end

            -- Toggle
            function tabAPI:CreateToggle(c)
                local wrap = Instance.new("TextButton", page)
                wrap.Size = UDim2.new(1, 0, 0, 38)
                wrap.BackgroundColor3 = BG_ELEM
                wrap.BorderSizePixel = 0
                wrap.Text = ""
                wrap.AutoButtonColor = false
                local wcr = Instance.new("UICorner", wrap); wcr.CornerRadius = UDim.new(0, 6)

                local lbl = Instance.new("TextLabel", wrap)
                lbl.Text = "   " .. (c.Name or "Toggle")
                lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
                lbl.Size = UDim2.new(1, -60, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 13
                lbl.TextXAlignment = Enum.TextXAlignment.Left

                local track = Instance.new("Frame", wrap)
                track.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                track.Position = UDim2.new(1, -45, 0.5, -10)
                track.Size = UDim2.new(0, 36, 0, 20)
                track.BorderSizePixel = 0
                local tkcr = Instance.new("UICorner", track); tkcr.CornerRadius = UDim.new(1, 0)

                local knob = Instance.new("Frame", track)
                knob.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
                knob.Position = UDim2.new(0, 2, 0.5, -8)
                knob.Size = UDim2.new(0, 16, 0, 16)
                knob.BorderSizePixel = 0
                local kncr = Instance.new("UICorner", knob); kncr.CornerRadius = UDim.new(1, 0)

                local state = c.CurrentValue or false
                local function setVis(s)
                    if s then
                        TS:Create(knob, TweenInfo.new(0.3), {
                            Position = UDim2.new(1, -18, 0.5, -8),
                            BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                        }):Play()
                        TS:Create(track, TweenInfo.new(0.3), {BackgroundColor3 = ACCENT}):Play()
                    else
                        TS:Create(knob, TweenInfo.new(0.3), {
                            Position = UDim2.new(0, 2, 0.5, -8),
                            BackgroundColor3 = Color3.fromRGB(150, 150, 150)
                        }):Play()
                        TS:Create(track, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}):Play()
                    end
                end
                setVis(state)

                wrap.MouseEnter:Connect(function()
                    TS:Create(wrap, TweenInfo.new(0.2), {BackgroundColor3 = BG_HOVER}):Play()
                end)
                wrap.MouseLeave:Connect(function()
                    TS:Create(wrap, TweenInfo.new(0.2), {BackgroundColor3 = BG_ELEM}):Play()
                end)
                wrap.MouseButton1Click:Connect(function()
                    state = not state
                    setVis(state)
                    safe(c.Callback, state)
                end)
                return wrap
            end

            -- Slider
            function tabAPI:CreateSlider(c)
                local box = Instance.new("Frame", page)
                box.Size = UDim2.new(1, 0, 0, 50)
                box.BackgroundColor3 = BG_ELEM
                box.BorderSizePixel = 0
                local bcr3 = Instance.new("UICorner", box); bcr3.CornerRadius = UDim.new(0, 6)

                local minV = c.Range and c.Range[1] or 0
                local maxV = c.Range and c.Range[2] or 100
                local initV = c.CurrentValue or minV

                local lbl = Instance.new("TextLabel", box)
                lbl.Text = "   " .. (c.Name or "Slider") .. " : " .. tostring(initV)
                lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
                lbl.Size = UDim2.new(1, 0, 0, 25)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.Gotham
                lbl.TextSize = 12
                lbl.TextXAlignment = Enum.TextXAlignment.Left

                local track = Instance.new("Frame", box)
                track.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                track.Position = UDim2.new(0, 10, 0, 30)
                track.Size = UDim2.new(1, -20, 0, 6)
                track.BorderSizePixel = 0
                local tcr3 = Instance.new("UICorner", track); tcr3.CornerRadius = UDim.new(1, 0)

                local pct = math.clamp((initV - minV) / (maxV - minV), 0, 1)
                local fill = Instance.new("Frame", track)
                fill.BackgroundColor3 = ACCENT
                fill.Size = UDim2.new(pct, 0, 1, 0)
                fill.BorderSizePixel = 0
                local fcr = Instance.new("UICorner", fill); fcr.CornerRadius = UDim.new(1, 0)

                local dragging = false
                local function upd(input)
                    local p = math.clamp(
                        (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
                        0, 1)
                    fill.Size = UDim2.new(p, 0, 1, 0)
                    local v = math.floor((maxV - minV) * p + minV)
                    lbl.Text = "   " .. (c.Name or "Slider") .. " : " .. tostring(v)
                    safe(c.Callback, v)
                end
                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        upd(input)
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        upd(input)
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
                return box
            end

            -- Input
            function tabAPI:CreateInput(c)
                local box = Instance.new("Frame", page)
                box.Size = UDim2.new(1, 0, 0, 38)
                box.BackgroundColor3 = BG_ELEM
                box.BorderSizePixel = 0
                local bcr4 = Instance.new("UICorner", box); bcr4.CornerRadius = UDim.new(0, 6)

                local tb = Instance.new("TextBox", box)
                tb.Size = UDim2.new(1, -20, 1, 0)
                tb.Position = UDim2.new(0, 10, 0, 0)
                tb.BackgroundTransparency = 1
                tb.Text = c.CurrentValue or ""
                tb.PlaceholderText = c.PlaceholderText or c.Name or "..."
                tb.TextColor3 = Color3.fromRGB(200, 200, 200)
                tb.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
                tb.Font = Enum.Font.Gotham
                tb.TextSize = 13
                tb.TextXAlignment = Enum.TextXAlignment.Left
                tb.ClearTextOnFocus = false

                tb.FocusLost:Connect(function()
                    safe(c.Callback, tb.Text)
                end)
                return tb
            end

            -- Label
            function tabAPI:CreateLabel(text)
                local l = Instance.new("TextLabel", page)
                l.Size = UDim2.new(1, 0, 0, 24)
                l.BackgroundTransparency = 1
                l.Text = text
                l.TextColor3 = Color3.fromRGB(190, 190, 190)
                l.Font = Enum.Font.Gotham
                l.TextSize = 12
                l.TextXAlignment = Enum.TextXAlignment.Left
                l.TextWrapped = true
                return l
            end

            return tabAPI
        end

        return winAPI
    end

    function Engine:Notify(cfg)
        if not notifContainer or not notifContainer.Parent then return end
        cfg = cfg or {}
        local f = Instance.new("Frame", notifContainer)
        f.Size = UDim2.new(0, 300, 0, 40)
        f.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
        f.BackgroundTransparency = 1
        f.BorderSizePixel = 0
        local fcr = Instance.new("UICorner", f); fcr.CornerRadius = UDim.new(0, 8)
        local fst = Instance.new("UIStroke", f)
        fst.Color = ACCENT; fst.Thickness = 1.5; fst.Transparency = 1

        local l = Instance.new("TextLabel", f)
        l.Size = UDim2.new(1, -20, 1, 0)
        l.Position = UDim2.new(0, 10, 0, 0)
        l.BackgroundTransparency = 1
        l.Text = (cfg.Title or "joaozin") .. ": " .. (cfg.Content or "")
        l.TextColor3 = Color3.fromRGB(255, 255, 255)
        l.Font = Enum.Font.GothamBold
        l.TextSize = 13
        l.TextWrapped = true
        l.TextTransparency = 1

        TS:Create(f, TweenInfo.new(0.3), {BackgroundTransparency = 0.1}):Play()
        TS:Create(fst, TweenInfo.new(0.3), {Transparency = 0}):Play()
        TS:Create(l, TweenInfo.new(0.3), {TextTransparency = 0}):Play()

        task.delay(cfg.Duration or 3, function()
            if not f or not f.Parent then return end
            TS:Create(f, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
            TS:Create(fst, TweenInfo.new(0.3), {Transparency = 1}):Play()
            TS:Create(l, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
            task.wait(0.3)
            f:Destroy()
        end)
    end

    return Engine
end)()

