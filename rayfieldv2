        notifContainer.Parent = gui
        notifContainer.BackgroundTransparency = 1
        notifContainer.Size = UDim2.new(1, 0, 0, 0)
        notifContainer.Position = UDim2.new(0, 0, 0, 30)
        notifContainer.ZIndex = 100
        local nll = Instance.new("UIListLayout", notifContainer)
        nll.SortOrder = Enum.SortOrder.LayoutOrder
        nll.HorizontalAlignment = Enum.HorizontalAlignment.Center
