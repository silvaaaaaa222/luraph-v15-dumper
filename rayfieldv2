        local gui = Instance.new("ScreenGui")
        gui.Name = guiName
        gui.Parent = CoreGui
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        if syn and syn.protect_gui then pcall(function() syn.protect_gui(gui) end) end

        -- Notif container
