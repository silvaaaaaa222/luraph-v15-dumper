local UIEngine = (function()
    local UIS = game:GetService("UserInputService")
    local TS  = game:GetService("TweenService")
    local CoreGui = (gethui and gethui()) or game:GetService("CoreGui")
    local LP  = game:GetService("Players").LocalPlayer

    local ACCENT = Color3.fromRGB(0, 195, 255)
    local ACCENT2 = Color3.fromRGB(100, 220, 255)
    local BG_MAIN = Color3.fromRGB(15, 15, 15)
    local BG_ELEM = Color3.fromRGB(25, 25, 25)
    local BG_HOVER = Color3.fromRGB(35, 35, 35)

    local Engine = {}
    local notifContainer

    function Engine:CreateWindow(cfg)
        cfg = cfg or {}
        local title = cfg.Name or "joaozin menu"
